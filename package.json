{
  "name": "image-queue",
  "version": "1.0.0",
  "private": true,
  "description": "排队领取图片：按时间窗口限流放行，接入 Cap 人机验证，附带 MUI 控制台",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "concurrently -n api,web \"node --watch server/index.js\" \"vite\"",
    "build": "vite build",
    "start": "node server/index.js",
    "test": "node --test test/"
  },
  "dependencies": {
    "@cap.js/server": "4.0.5",
    "express": "5.3.0",
    "multer": "2.5.0"
  },
  "devDependencies": {
    "@cap.js/wasm": "^0.0.8",
    "@emotion/react": "11.14.0",
    "@emotion/styled": "11.14.1",
    "@mui/icons-material": "9.5.0",
    "@mui/material": "9.5.0",
    "@vitejs/plugin-react": "6.1.2",
    "cap-widget": "0.1.58",
    "concurrently": "10.0.6",
    "react": "19.2.9",
    "react-dom": "19.2.9",
    "vite": "8.3.5"
  }
}
