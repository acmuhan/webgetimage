# 控制台登录密码（必填，至少 8 位，建议 16 位以上随机字符串）
ADMIN_PASSWORD=change-me-please

# 宿主机端口
HOST_PORT=3000

# 两种部署方式，二选一：
#
# A. 放在 Nginx / Caddy 等反向代理后面（推荐）
#    BIND_ADDR=127.0.0.1   只允许本机的代理访问
#    TRUST_PROXY=1         从 X-Forwarded-For 取访客真实 IP
#
# B. 不用反向代理，直接对外
#    BIND_ADDR=0.0.0.0
#    TRUST_PROXY=          必须留空，否则访客可以伪造 IP，绕过每 IP 限制和登录锁定
#
# 只设 TRUST_PROXY=1 却对外开放端口是不安全的；
# 在代理后面却不设 TRUST_PROXY，所有访客会被当成同一个 IP，每 IP 限制会误伤。
BIND_ADDR=127.0.0.1
TRUST_PROXY=1

# 上传图片大小上限（MB）
MAX_UPLOAD_MB=20
